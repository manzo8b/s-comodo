---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in site.pages %}
{% assign last_char = item.url | slice: -1, 1 %}
{% if last_char == '/' and item.seo_noindex != true %}
  <url>
    <loc>{{ item.url | absolute_url | xml_escape }}</loc>
  </url>
{% endif %}
{% endfor %}
{% for post in site.posts %}
{% if post.reviewed == true and post.editorial_status == 'pubblicato' or post.reviewed == true and post.editorial_status == 'published' %}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
  </url>
{% endif %}
{% endfor %}
</urlset>
